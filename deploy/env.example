# Copy to /etc/conduit/env on the Droplet, then `chmod 600`.
# All values are read by services/middleman/src/config.ts.

# Local port the middleman binds to. Caddy reverse-proxies to this.
PORT=3333

# Persistent state. The deploy script assumes these paths.
DATA_DIR=/var/lib/conduit/data
REAL_ROOT=/var/lib/conduit/shadow

# Single shared token (Phase 1). Generate with: openssl rand -hex 32
# Stays as an admin escape hatch in Phase 2 (use email + password instead).
API_TOKEN=replace-me-with-a-long-random-hex-string

# Phase 2: enables sealing SSH credentials to sqlite so a server restart can
# revive workspaces without re-entering passwords. Without this, secrets are
# memory-only (and need to be re-pasted on every reboot).
# Generate with: openssl rand -hex 32
# CONDUIT_SECRET_KEY=

# Phase 2: explicit sqlite location. Defaults to "${DATA_DIR}/conduit.db".
# DB_PATH=/var/lib/conduit/data/conduit.db

# Phase 2: when "false", only admins (API_TOKEN holders) can create accounts.
# Default "true" matches the "trusted team" model.
# ALLOW_SELF_SIGNUP=true

# Node runtime
NODE_ENV=production

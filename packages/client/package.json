  },
  "dependencies": {
    "@conduit/shared": "*",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.23"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }

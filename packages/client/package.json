{
  "name": "@conduit/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core/documentSync": {
      "types": "./src/core/documentSync.ts",
      "default": "./src/core/documentSync.ts"
    },
    "./core/wsPool": {
      "types": "./src/core/wsPool.ts",
      "default": "./src/core/wsPool.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",

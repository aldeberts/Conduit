# HTTP port for the middleman API (health + future WebSocket).
PORT=3333

# Directory where on-save flushes land in Phase 0 (path relative to repo root or absolute).
REAL_ROOT=./real_shadow

# Persisted Yjs document state (Phase C). Survives middleman restarts.
DATA_DIR=./data/conduit

# Optional: require Bearer / X-Conduit-Token / ?token= on HTTP and WebSocket (Phase C).
# API_TOKEN=your-dev-token
